<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Piste Hunters — https://pistehunters.com (Scouted by Zakaria | Amnir)"
  xmlns="http://www.topografix.com/GPX/1/1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Piste Hunters — High Atlas GPS Calibration Sample (5 Gateways + 4.5 km Test Track)</name>
    <desc>Free GPX 1.1 calibration file containing 5 public High Atlas gateway &amp; fuel waypoints plus a 4.5 km public Bin El Ouidane lake overlook test track (825m to 1,280m) to verify offline track rendering, elevation charts, and waypoint symbols in Gaia GPS, OsmAnd, and Garmin Overlander before starting Expedition Pack #01.</desc>
    <author>
      <name>Zakaria | Amnir — Founder &amp; Lead Scout, Piste Hunters</name>
      <link href="https://pistehunters.com/">
        <text>Piste Hunters — Morocco Off-Road GPX Tracks &amp; 4x4 Roadbooks</text>
      </link>
    </author>
    <time>2026-11-16T08:00:00Z</time>
  </metadata>
  <wpt lat="32.11520" lon="-6.46280">
    <ele>825</ele>
    <name>PH-GATEWAY-01 Bin El Ouidane Air-Down &amp; Lake Overlook</name>
    <desc>Public northern gateway parking near Bin El Ouidane lake. Air down tires to 1.8 bar (Crossover/Van) or 1.7 bar (4x4/Moto) and verify offline satellite tiles before entering Loop 01 or Loop 05.</desc>
    <sym>Flag, Blue</sym>
    <type>Gateway</type>
  </wpt>
  <wpt lat="31.96150" lon="-6.57100">
    <ele>1379</ele>
    <name>PH-FUEL-02 Azilal Regional Fuel &amp; Mechanic Hub</name>
    <desc>Primary northern High Atlas fuel, tire repair, and mechanic town before climbing toward Aït Bouguemez Happy Valley on Loop 02.</desc>
    <sym>Gas Station</sym>
    <type>Fuel &amp; Supply</type>
  </wpt>
  <wpt lat="32.57140" lon="-6.02670">
    <ele>1110</ele>
    <name>PH-GATEWAY-03 El Ksiba Cedar Foothills Entry Gateway</name>
    <desc>Public north-eastern High Atlas gateway at El Ksiba. Top up diesel/petrol to 100% before ascending onto the Aghbala and Imilchil plateaus (Loop 03 &amp; Loop 04).</desc>
    <sym>Flag, Blue</sym>
    <type>Gateway</type>
  </wpt>
  <wpt lat="31.83580" lon="-6.10510">
    <ele>1514</ele>
    <name>PH-SUPPLY-04 Zaouiat Ahansal Valley Village Center</name>
    <desc>Public village center in Zaouiat Ahansal canyon. Fresh bread, water, and basic provisions before the Level 3 climb toward the 3,341m pass on Loop 01.</desc>
    <sym>Shopping Center</sym>
    <type>Fuel &amp; Supply</type>
  </wpt>
  <wpt lat="31.37250" lon="-5.99640">
    <ele>1603</ele>
    <name>PH-FUEL-05 Boumalne Dades Southern Gateway Fuel Station</name>
    <desc>Southern High Atlas main fuel station and N10 gateway at Boumalne Dades prior to entering the Dades Gorges and Tisdrine switchbacks (Loop 02 &amp; Loop 03).</desc>
    <sym>Gas Station</sym>
    <type>Fuel &amp; Supply</type>
  </wpt>
  <trk>
    <name>PH-CALIBRATION Bin El Ouidane Lake Overlook Approach (4.5 km Test Track)</name>
    <desc>Public 4.5 km gateway calibration climb overlooking Bin El Ouidane turquoise lake (825m to 1,280m). Use this test segment to verify track line width, color, and elevation profile rendering in Gaia GPS, OsmAnd, Garmin, and Google Earth. Full 3,184 km 5-loop network is unlocked inside Expedition Pack #01 at https://pistehunters.com/packs/high-atlas-pack-01/</desc>
    <type>Calibration Track</type>
    <trkseg>
      <trkpt lat="32.11520" lon="-6.46280"><ele>825</ele></trkpt>
      <trkpt lat="32.11440" lon="-6.46090"><ele>842</ele></trkpt>
